{
  "name": "korg-discord-ios",
  "version": "0.2.0",
  "private": true,
  "description": "Korg, an experimental Rain-based Discord modification for iOS",
  "type": "module",
  "license": "MPL-2.0",
  "engines": { "node": ">=22" },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "prepare:native": "node scripts/verify.mjs && node scripts/prepare-native.mjs",
    "build:native": "bash scripts/build-native.sh"
  }
}
